import { CxTheme } from "../theme.slint";

export component CxStatus inherits Rectangle {
    in property <string> label;
    // Domain state: "success", "warning", "danger", or neutral.
    in property <string> state: "neutral";
    background: CxTheme.surface;
    border-color: CxTheme.border;
    border-width: 1px;
    border-radius: 4px;
    height: 28px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: root.state == "success" ? CxTheme.success :
                        root.state == "warning" ? CxTheme.warning :
                        root.state == "danger" ? CxTheme.danger : CxTheme.accent;
        }
        Text {
            text: root.label;
            color: CxTheme.surface-foreground;
            font-size: 12px;
        }
    }
}
