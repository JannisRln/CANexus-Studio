{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "CANexus Studio Design Tokens",
  "version": "0.1.0",
  "status": "Proposed",
  "platforms": ["Windows", "Linux"],
  "theme": {
    "color": {
      "canvas": {"$type": "color", "$value": "#0B121A"},
      "surface1": {"$type": "color", "$value": "#101C27"},
      "surface2": {"$type": "color", "$value": "#152532"},
      "surface3": {"$type": "color", "$value": "#1D3342"},
      "border": {"$type": "color", "$value": "#2A4051"},
      "textPrimary": {"$type": "color", "$value": "#E8F2F7"},
      "textMuted": {"$type": "color", "$value": "#98AFBE"},
      "accent": {"$type": "color", "$value": "#25D3BF"},
      "info": {"$type": "color", "$value": "#69BFF5"},
      "success": {"$type": "color", "$value": "#4CD6A1"},
      "warning": {"$type": "color", "$value": "#FFC36B"},
      "danger": {"$type": "color", "$value": "#FF7488"},
      "plot1": {"$type": "color", "$value": "#38D7CC"},
      "plot2": {"$type": "color", "$value": "#F4BD53"},
      "plot3": {"$type": "color", "$value": "#D788F5"},
      "plot4": {"$type": "color", "$value": "#76AFF8"}
    },
    "spacing": {
      "1": {"$type": "dimension", "$value": "4px"},
      "2": {"$type": "dimension", "$value": "8px"},
      "3": {"$type": "dimension", "$value": "12px"},
      "4": {"$type": "dimension", "$value": "16px"},
      "6": {"$type": "dimension", "$value": "24px"},
      "8": {"$type": "dimension", "$value": "32px"}
    },
    "size": {
      "controlCompact": {"$type": "dimension", "$value": "30px"},
      "controlComfortable": {"$type": "dimension", "$value": "36px"},
      "rowCompact": {"$type": "dimension", "$value": "28px"},
      "rowComfortable": {"$type": "dimension", "$value": "34px"},
      "toolbar": {"$type": "dimension", "$value": "42px"},
      "statusBar": {"$type": "dimension", "$value": "28px"},
      "explorerWidth": {"$type": "dimension", "$value": "256px"},
      "inspectorWidth": {"$type": "dimension", "$value": "296px"}
    },
    "radius": {
      "small": {"$type": "dimension", "$value": "4px"},
      "default": {"$type": "dimension", "$value": "6px"}
    },
    "typography": {
      "ui": {"$type": "fontFamily", "$value": ["Inter", "Segoe UI", "system-ui"]},
      "code": {"$type": "fontFamily", "$value": ["JetBrains Mono", "IBM Plex Mono", "Consolas", "monospace"]},
      "baseSize": {"$type": "dimension", "$value": "13px"},
      "tableSize": {"$type": "dimension", "$value": "12px"}
    }
  }
}